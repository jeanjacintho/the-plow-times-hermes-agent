# Descriptor for this agent. agent-mgr supplies everything else.
#
# Every key here is optional -- agent-mgr derives all of them from the agent's
# name. Set one only to override the convention, and say why. Defaults for
# `the-plow-times`: AGENT_HOME ~/.hermes-the-plow-times, AGENT_CONTAINER
# hermes-the-plow-times, AGENT_PROJECT hermes-the-plow-times, AGENT_TZ
# America/Los_Angeles fleet-wide.

# One deliberate override: the config lives in runtime/ beside SOUL.md, the
# way the design doc's skeleton lays this repo out, instead of at the root
# where agent-mgr's default would look for it.
AGENT_CONFIG=runtime/config.yaml

# The skill directories are seeded into the agent's writable home by
# deploy-hook -- copied when absent or empty, never over a non-empty
# agent-owned copy. A hook path is not identity: it resolves against each
# instance's own checkout.
AGENT_DEPLOY_HOOK=deploy-hook

# This agent builds its own image instead of running the fleet pin: the base
# plus weasyprint, so the edition renderer can emit the paper's PDF leg
# (Dockerfile). The live boot path is compose.yml (`docker compose up --build`).
# AGENT_IMAGE remains for a leftover agent-mgr inspect; it is not what
# plow-agents compose uses.
AGENT_IMAGE=the-plow-times-hermes-agent:local

# Instances of this repo are live: real research jobs run through them
# unattended, and the gateway messages its person at every restart -- so
# agent-mgr asks [y/N] before any transition, and refuses non-interactively
# unless AGENT_TRANSITION_ACK=1 is set.
AGENT_LIVE=1

# Written in place by `agent-mgr activate the-plow-times`. Do not fill these by
# hand: the chat uid and token are minted together by the activation exchange,
# and a hand-typed pair that does not match will authenticate as nothing.
PLOW_CHAT_CHAT_UID=
PLOW_CHAT_TOKEN=