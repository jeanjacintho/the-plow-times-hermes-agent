#!/bin/sh
# Drop the `latch` mcp_servers entry this repo used to declare, once.
#
# The image's config.yaml lands in /var/lib/hermes, which is the agent-home
# volume, so it is shadowed after first create -- the same shadowing the
# Dockerfile already notes for skills. plow-init then writes only the keys it
# owns and preserves every other mcp_servers entry, so deleting `latch` from
# runtime/config.yaml reaches a NEW install and no existing one: the legacy
# entry would otherwise sit there forever, enabled, still interpolating the
# retired DOMO_* pair, failing its connect every five minutes.
#
# It runs once per home and leaves a marker. That is what makes it a migration
# rather than a standing reconcile, and it is why no predicate guards the
# delete: a hook that has already run cannot mistake a later server named
# `latch` for the retired one, so it does not have to tell them apart.
#
# Temporary: delete this hook, and the marker it writes, once no install
# predates the single-credential change.
set -eu
/opt/hermes/.venv/bin/python3 - \
  /var/lib/hermes/config.yaml /var/lib/hermes/.pt-legacy-latch-retired <<'PY'
import os
import sys
import yaml

config_path, marker_path = sys.argv[1], sys.argv[2]
if os.path.exists(marker_path) or not os.path.exists(config_path):
    sys.exit(0)

with open(config_path) as handle:
    config = yaml.safe_load(handle) or {}

servers = config.get("mcp_servers")
if isinstance(servers, dict) and servers.pop("latch", None) is not None:
    # An empty mapping would read as "this agent declares no relay" and clobber
    # the image-managed `plow` entry on merge; drop the key itself instead.
    if not servers:
        del config["mcp_servers"]
    # Same shape as 02-copy-plow-credentials: a boot-critical file is replaced,
    # not truncated in place, so an interrupted write cannot leave an agent
    # that will not start. The rename is atomic within the directory.
    stat = os.stat(config_path)
    tmp = config_path + ".tmp"
    with open(tmp, "w") as handle:
        yaml.safe_dump(config, handle, allow_unicode=True, sort_keys=False)
        handle.flush()
        os.fsync(handle.fileno())
    os.chown(tmp, stat.st_uid, stat.st_gid)
    os.chmod(tmp, stat.st_mode & 0o7777)
    os.replace(tmp, config_path)
    print("retired the legacy latch mcp_servers entry")

# Written whether or not anything was removed -- a home that never carried the
# entry is migrated too, and asking again every boot is the thing being fixed.
with open(marker_path, "w") as handle:
    handle.write("the-plow-times retired mcp_servers.latch here\n")
PY
