#!/bin/sh
# The seed reaches a home only when it has no config.yaml (01-hermes-setup),
# and plow-init re-stamps only the keys it owns, so every other key in
# runtime/config.yaml stopped at the image for an existing home. Measured on
# Alder, 2026-09-25: agent.disabled_toolsets and cron.model were absent from
# the home the paper ran on. Re-merged every boot; plow-init runs after this.
set -eu
exec /opt/hermes/.venv/bin/python3 /opt/plow/merge_pt_seed_config.py \
  /var/lib/hermes/config.yaml /opt/plow/pt-runtime-config.yaml
