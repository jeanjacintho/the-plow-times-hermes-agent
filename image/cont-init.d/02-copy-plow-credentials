#!/bin/sh
# plow-init waits for /var/lib/plow/credentials (root:root 0600). Compose
# bind-mounts the minted line at credentials.host so a recreate cannot
# shadow a missing file with an empty directory. Measured live after
# `compose up --build`: the host file was there, credentials was not,
# plow-init parked after 60s, and the gateway never started.
set -eu
host=/var/lib/plow/credentials.host
dest=/var/lib/plow/credentials
[ -f "$dest" ] && exit 0
[ -f "$host" ] || exit 0
rm -f "$dest.tmp"
( set -C; cat "$host" > "$dest.tmp" )
chown root:root "$dest.tmp"
chmod 0600 "$dest.tmp"
mv -f "$dest.tmp" "$dest"
