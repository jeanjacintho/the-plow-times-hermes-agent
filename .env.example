# Secrets for this agent. Never commit real values.
#
# The gateway reads this file at its own HERMES_HOME/.env through the home
# mount -- compose passes no credentials. That is the whole contract for
# PLOW_HOME_CHANNEL.
#
# The Plow credential itself is NOT here: `agent-mgr activate` mints it into
# a file OUTSIDE every agent's home (`agent-mgr resolve` never prints it),
# because the gateway strips those keys out of this file on every boot.

# Written in place by `agent-mgr set-home`; do not fill it by hand.
PLOW_HOME_CHANNEL=

# Plow Latch: which Mac this agent drives, and its relay credential. Mint both
# from the Mac running Plow Latch -- POST /v1/relay/agents needs the
# relay:device scope, which only that Mac holds -- then `agent-mgr
# set-latch the-plow-times`, which reads them on stdin and writes them here, so
# the token never reaches a shell history or the process table. That command
# owns the spelling of these lines: `KEY=value` at column 0 is the form this
# tool writes and the only one it reads back, so an `export` or indented hand
# edit reads as absent.
#
# Shipped bare, with no `=`: a PRESENT key with a blank value still clobbers a
# credential the container's own environment supplies through a compose
# override, because hermes' dotenv load keys off presence, not emptiness. A
# bare line reads as absent instead, leaving that fallback intact.
DOMO_DEVICE_UID
DOMO_MCP_TOKEN

# Which model plow-init writes into runtime/config.yaml at every boot. The
# config's own model: block is NOT authoritative for this image -- plow-init
# (/etc/s6-overlay/scripts/plow-init.py) rewrites model.provider/model.default
# from these two on every boot, defaulting to the Plow-hosted model when
# either is unset (confirmed live in memory-vault-hermes-agent: the model kept
# resetting to the Plow-hosted default under provider: plow no matter what the
# config declared, until these were set). Setting them HERE does nothing:
# plow-init reads the real process environment, not this file, so the pair is
# pinned in compose.override.yml -- this block documents the pair and the
# value it must match. Also register the matching key with
# `hermes auth add <provider> --type api-key` -- these two name which
# provider/model to use, not the credential to use it with.
HERMES_PROVIDER=openrouter
HERMES_MODEL=google/gemini-2.5-flash-lite