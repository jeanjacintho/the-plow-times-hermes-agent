# Secrets for this agent. Never commit real values.
#
# The gateway reads this file at its own HERMES_HOME/.env through the home
# mount -- compose passes no credentials. That is the whole contract for
# PLOW_HOME_CHANNEL.
#
# The Plow credential itself is NOT here: `agent-mgr activate` mints it into
# a file OUTSIDE every agent's home (`agent-mgr resolve` never prints it),
# because the gateway strips those keys out of this file on every boot.

# Written in place by `agent-mgr set-home`; do not fill it by hand.
PLOW_HOME_CHANNEL=
