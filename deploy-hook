#!/bin/sh
# Seed the pt-* skills and the persona into the agent's home.
#
# Skills used to skip any non-empty dest ("a destination that exists
# non-empty is the agent's"). That meant an agent-mgr home never saw a
# skill PR. Hermes already reconciles compose homes by origin hash
# (.bundled_manifest): update a copy we wrote that the agent has not
# edited; keep one it has. This hook now does the same via
# pt-shared/scripts/reconcile_pt_skills.py. Unstamped dirs are the old
# hook's copies and get one re-seed; after that the stamp protects edits.
#
# SOUL.md and USER.md stay repo-owned and are copied every deploy.
#
# agent-mgr exports AGENT_HOME; cwd is not assumed -- the script finds the
# skill dirs beside itself, and a checkout without any is broken, not drifted.
set -eu
cd "$(dirname "$0")"
home="${AGENT_HOME:?agent-mgr exports this}"

python3 pt-shared/scripts/reconcile_pt_skills.py "$home"

# The persona, published every deploy like config.yaml is.
if [ -f runtime/SOUL.md ]; then
    cp runtime/SOUL.md "$home/SOUL.md.incoming"
    mv "$home/SOUL.md.incoming" "$home/SOUL.md"
    echo "the-plow-times: published SOUL.md to $home"
else
    echo "the-plow-times: no runtime/SOUL.md -- broken checkout" >&2
    exit 1
fi

# USER.md is also repo-owned: an empty memories/USER.md is what makes the
# Hermes/Plow first-run offer a personal-profile interview (name, how they
# like to work). We publish a stub that forbids that interview so a wiped
# home still opens on the newspaper setup, not Alder.
mkdir -p "$home/memories"
if [ -f runtime/USER.md ]; then
    cp runtime/USER.md "$home/memories/USER.md.incoming"
    mv "$home/memories/USER.md.incoming" "$home/memories/USER.md"
    echo "the-plow-times: published USER.md to $home/memories"
else
    echo "the-plow-times: no runtime/USER.md -- broken checkout" >&2
    exit 1
fi
